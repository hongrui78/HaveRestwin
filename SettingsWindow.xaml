<Window x:Class="HaveRestwin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <TabControl Margin="8">
        <!-- ======================= 通用 ======================= -->
        <TabItem x:Name="GeneralTab">
            <StackPanel Margin="14" >
                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock x:Name="LanguageLabel" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LanguageCombo" DockPanel.Dock="Right" Width="150"
                              SelectedValuePath="Tag" SelectionChanged="Language_Changed">
                        <ComboBoxItem x:Name="LangSystemItem" Tag="system"/>
                        <ComboBoxItem x:Name="LangEnglishItem" Tag="english" Content="English"/>
                        <ComboBoxItem x:Name="LangSimplifiedItem" Tag="chinese"/>
                        <ComboBoxItem x:Name="LangTraditionalItem" Tag="traditional"/>
                    </ComboBox>
                </DockPanel>
                <CheckBox x:Name="LaunchCheck" Margin="0,4" IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}"/>
                <CheckBox x:Name="ShowTimerCheck" Margin="0,4" IsChecked="{Binding ShowTimerInFloating, Mode=TwoWay}"/>
                <CheckBox x:Name="SoundCheck" Margin="0,4" IsChecked="{Binding PlaySoundOnBreakEnd, Mode=TwoWay}"/>
                <CheckBox x:Name="ExitBtnCheck" Margin="0,4" IsChecked="{Binding ShowExitButton, Mode=TwoWay}"/>
                <CheckBox x:Name="StandEnabledCheck" Margin="0,4"
                          IsChecked="{Binding StandEnabled, Mode=TwoWay}"/>
            </StackPanel>
        </TabItem>

        <!-- ======================= 休息 ======================= -->
        <TabItem x:Name="RestTab">
            <StackPanel Margin="14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <RadioButton x:Name="RadioEye" IsChecked="True" Checked="Kind_Changed" Margin="0,0,12,0"/>
                    <RadioButton x:Name="RadioStand" Checked="Kind_Changed"/>
                </StackPanel>

                <StackPanel x:Name="EyePanel">
                    <TextBlock x:Name="EyePlanTitle" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="EyeEveryLabel" VerticalAlignment="Center"/>
                        <TextBox Width="48" Margin="5,0" TextAlignment="Center"
                                 Text="{Binding EyeFrequencyMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock x:Name="EyeMinLabel" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="EyeRestLabel" VerticalAlignment="Center"/>
                        <TextBox Width="48" Margin="5,0" TextAlignment="Center"
                                 Text="{Binding EyeBreakSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock x:Name="EyeSecLabel" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="EyeDisplayTitle" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="EyeMsgLabel" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="200"
                                 Text="{Binding EyeMessage, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <TextBlock x:Name="EyePreviewCaption" Foreground="Gray" Margin="0,0,0,4"/>
                    <Border Background="{Binding EyePanelRenderColor}" BorderBrush="#DDD" BorderThickness="1"
                            CornerRadius="6" Height="110" Margin="0,0,0,8">
                        <TextBlock x:Name="EyePreviewText" FontSize="30" FontWeight="Bold"
                                   Foreground="{Binding EyeTextColor}"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <DockPanel LastChildFill="False" Margin="0,10,0,0">
                        <TextBlock x:Name="EyePanelColorLabel" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Left" Width="36" Height="18" Margin="8,0,0,0"
                                Background="{Binding EyePanelRenderColor}" Click="Swatch_Click" Tag="eyePanel">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="#999999"
                                            BorderThickness="1" CornerRadius="2" Cursor="Hand"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Slider x:Name="EyeOpacitySlider" DockPanel.Dock="Right" Width="96"
                                Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Value="{Binding EyePanelOpacity, Mode=TwoWay}"/>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="EyeOpacityBox" DockPanel.Dock="Right" Width="36" Margin="0,0,4,0"
                                 TextAlignment="Center" VerticalAlignment="Center"
                                 Text="{Binding EyePanelOpacity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock x:Name="EyeOpacityLabel" DockPanel.Dock="Right"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="EyeTextColorLabel" VerticalAlignment="Center"/>
                        <Button Width="36" Height="18" Margin="8,0,0,0"
                                Background="{Binding EyeTextColor}" Click="Swatch_Click" Tag="eyeText">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="#999999"
                                            BorderThickness="1" CornerRadius="2" Cursor="Hand"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="StandPanel" Visibility="Collapsed">
                    <TextBlock x:Name="StandPlanTitle" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="StandEveryLabel" VerticalAlignment="Center"/>
                        <TextBox Width="48" Margin="5,0" TextAlignment="Center"
                                 Text="{Binding StandMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock x:Name="StandMinLabel" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="StandRestLabel" VerticalAlignment="Center"/>
                        <TextBox Width="48" Margin="5,0" TextAlignment="Center"
                                 Text="{Binding StandBreakSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock x:Name="StandSecLabel" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="StandDisplayTitle" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="StandMsgLabel" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="200"
                                 Text="{Binding StandMessage, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <TextBlock x:Name="StandPreviewCaption" Foreground="Gray" Margin="0,0,0,4"/>
                    <Border Background="{Binding StandPanelRenderColor}" BorderBrush="#DDD" BorderThickness="1"
                            CornerRadius="6" Height="110" Margin="0,0,0,8">
                        <TextBlock x:Name="StandPreviewText" FontSize="30" FontWeight="Bold"
                                   Foreground="{Binding StandTextColor}"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <DockPanel LastChildFill="False" Margin="0,10,0,0">
                        <TextBlock x:Name="StandPanelColorLabel" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Left" Width="36" Height="18" Margin="8,0,0,0"
                                Background="{Binding StandPanelRenderColor}" Click="Swatch_Click" Tag="standPanel">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="#999999"
                                            BorderThickness="1" CornerRadius="2" Cursor="Hand"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Slider x:Name="StandOpacitySlider" DockPanel.Dock="Right" Width="96"
                                Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Value="{Binding StandPanelOpacity, Mode=TwoWay}"/>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="StandOpacityBox" DockPanel.Dock="Right" Width="36" Margin="0,0,4,0"
                                 TextAlignment="Center" VerticalAlignment="Center"
                                 Text="{Binding StandPanelOpacity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock x:Name="StandOpacityLabel" DockPanel.Dock="Right"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="StandTextColorLabel" VerticalAlignment="Center"/>
                        <Button Width="36" Height="18" Margin="8,0,0,0"
                                Background="{Binding StandTextColor}" Click="Swatch_Click" Tag="standText">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="#999999"
                                            BorderThickness="1" CornerRadius="2" Cursor="Hand"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="PreviewButton" HorizontalAlignment="Center" Margin="0,14,0,0"
                        Padding="20,4" Click="Preview_Click"/>
            </StackPanel>
        </TabItem>

        <!-- ======================= 关于 ======================= -->
        <TabItem x:Name="AboutTab">
            <StackPanel Margin="20" HorizontalAlignment="Center">
                <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                           Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,10"/>
                <TextBlock x:Name="AboutName" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="AboutVersion" Foreground="Gray"
                           HorizontalAlignment="Center" Margin="0,6,0,6"/>
                <TextBlock x:Name="AboutTagline" Foreground="Gray" TextAlignment="Center"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
