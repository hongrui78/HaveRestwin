<Window x:Class="HaveRestwin.FloatingWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaveARest"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Window.Resources>
        <!-- 下拉面板里的圆形小图标按钮（深色半透明底上的白色图标） -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 悬浮计时球：常驻显示倒计时/状态，可拖动 -->
        <Border x:Name="Pill" Grid.Row="0"
                CornerRadius="15" Background="#CC1F1F22"
                Padding="12,6" HorizontalAlignment="Left"
                Cursor="Hand"
                ToolTip="Have A Rest">
            <TextBlock x:Name="PillText"
                       Foreground="White" FontSize="14"
                       FontFamily="Consolas"
                       Text="20:00"/>
        </Border>

        <!-- 悬停展开的下拉控制面板：透明底，默认与计时球居中对齐，越界时自动左/右对齐 -->
        <Border x:Name="Panel" Grid.Row="1" Visibility="Collapsed"
                Width="270" Margin="0,6,0,0" HorizontalAlignment="Left"
                CornerRadius="14" Background="#B31F1F22"
                BorderBrush="#33FFFFFF" BorderThickness="1">
            <StackPanel Margin="16">
                <TextBlock x:Name="HeaderText" FontWeight="Bold" FontSize="15"
                           Foreground="White"/>
                <TextBlock x:Name="CountdownText"
                           HorizontalAlignment="Center"
                           FontFamily="Consolas" FontSize="14"
                           Foreground="#B3FFFFFF"
                           Margin="0,10,0,0"/>
                <TextBlock x:Name="StandText"
                           HorizontalAlignment="Center"
                           FontFamily="Consolas" FontSize="12"
                           Foreground="#99FFFFFF"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"/>
                <StackPanel x:Name="StandPendingBox" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock x:Name="StandPendingLabel"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold" Foreground="White"/>
                    <Button x:Name="StartStandButton"
                            HorizontalAlignment="Center" Margin="0,6,0,0"
                            Padding="10,4" Click="StartStand_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button x:Name="PauseToggleIcon" Style="{StaticResource IconButton}"
                            Click="PauseToggle_Click" ToolTip="暂停"/>
                    <Button x:Name="ResetIcon" Style="{StaticResource IconButton}"
                            Content="&#xE72C;" Click="Reset_Click" ToolTip="重置"/>
                    <Button x:Name="RestNowIcon" Style="{StaticResource IconButton}"
                            Content="&#xE708;" Click="RestNow_Click" ToolTip="立刻休息"/>
                    <Button x:Name="SettingsIcon" Style="{StaticResource IconButton}"
                            Content="&#xE713;" Click="Settings_Click" ToolTip="设置"/>
                    <Button x:Name="QuitIcon" Style="{StaticResource IconButton}"
                            Content="&#xE7E8;" Foreground="#FF8A80"
                            Click="Quit_Click" ToolTip="退出"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
